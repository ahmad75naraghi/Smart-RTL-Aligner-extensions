{
  "manifest_version": 3,
  "name": "Smart RTL Aligner",
  "version": "1.1.0",
  "author": "Ahmad Naraghi",
  "description": "Multi-mode RTL aligner with per-site persistence, optimized for AI chats and standard web layouts. Works on Firefox 109+.",
  "homepage_url": "https://github.com/ahmad75naraghi/Smart-RTL-Aligner-extensions",
  "browser_specific_settings": {
    "gecko": {
      "id": "smart-rtl-aligner@ahmadnaraghi",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RTL Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["rtl.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
